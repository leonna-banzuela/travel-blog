---
import { toSafeEmbedUrl } from "../content/public-content";
import { mediaSchema } from "../content/schemas";
import ResponsiveImage from "./ResponsiveImage.astro";

const media = mediaSchema.array().parse(Astro.props.media);
const passages = Array.isArray(Astro.props.passages)
  ? Astro.props.passages.filter((passage) => typeof passage === "string")
  : [];
---

{
  media.length > 0 && (
    <section class="story-section story-journey" aria-labelledby="gallery-title">
      <p class="eyebrow">The story</p>
      <h2 id="gallery-title" class="sr-only">Photos, videos, and story</h2>
      <div class="media-gallery story-copy">
        {media.map((item, index) => (
          <div class:list={["story-moment", { "story-moment--reverse": index % 2 === 1 }] }>
            {passages[index] && <p class="story-passage">{passages[index]}</p>}
            <figure class:list={["media-item", `media-item--${item.kind}`]}>
            {item.kind === "image" && (
              <ResponsiveImage
                media={item}
                sizes="(max-width: 700px) 100vw, 50vw"
              />
            )}
            {item.kind === "video" && (
              <video controls preload="metadata" poster={item.poster} aria-label={item.altText}>
                <source src={item.src} />
              </video>
            )}
            {item.kind === "video-embed" && (
              <iframe
                src={toSafeEmbedUrl(item.src)}
                title={item.altText}
                loading="lazy"
                allow="accelerometer; autoplay; encrypted-media; picture-in-picture"
                allowfullscreen
                referrerpolicy="strict-origin-when-cross-origin"
              />
            )}
            {item.caption && <figcaption>{item.caption}</figcaption>}
            </figure>
          </div>
        ))}
        {passages.length > media.length && (
          <div class="story-closing">
            {passages.slice(media.length).map((passage) => <p class="story-passage">{passage}</p>)}
          </div>
        )}
      </div>
    </section>
  )
}
