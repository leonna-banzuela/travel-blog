---
const { title } = Astro.props;
---

<button class="button button--paper share-button" type="button" data-share-button data-title={title}>
  <span data-share-label>Share story</span>
</button>

<script>
  for (const element of document.querySelectorAll("[data-share-button]")) {
    if (!(element instanceof HTMLButtonElement)) continue;
    const button = element;
    button.addEventListener("click", async () => {
      const label = button.querySelector("[data-share-label]");
      const shareData = {
        title: button.dataset.title ?? document.title,
        url: window.location.href,
      };

      try {
        if (navigator.share) {
          await navigator.share(shareData);
          return;
        }
        await navigator.clipboard.writeText(shareData.url);
        if (label instanceof HTMLElement) label.textContent = "Link copied";
      } catch (error) {
        if (error instanceof DOMException && error.name === "AbortError") return;
        if (label instanceof HTMLElement)
          label.textContent = "Copy the address above";
      }
    });
  }
</script>
