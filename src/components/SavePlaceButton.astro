---
const { placeId, placeName, compact = false, iconOnly = false } = Astro.props;
---

<div class:list={["save-place", { "save-place--compact": compact, "save-place--icon": iconOnly }] }>
  <button
    class:list={["button", "button--paper", { "icon-button": iconOnly }]}
    type="button"
    data-save-place
    data-place-id={placeId}
    data-place-name={placeName}
    aria-pressed="false"
    aria-label={iconOnly ? `Save ${placeName}` : undefined}
    title={iconOnly ? `Save ${placeName}` : undefined}
  >
    {iconOnly && <svg viewBox="0 0 24 24" aria-hidden="true"><path data-save-icon d="M12 20.5 4.8 13.8A5.2 5.2 0 0 1 12 6.3a5.2 5.2 0 0 1 7.2 7.5Z" /></svg>}
    <span class:list={{ "sr-only": iconOnly }} data-save-label>Save {placeName}</span>
  </button>
  {!compact && <p>Saved only in this browser. No account or cloud sync.</p>}
</div>

<script>
  const storageKey = "leonna-travel-blog:saved-places:v1";

  function readSaved() {
    try {
      const value = JSON.parse(localStorage.getItem(storageKey) ?? "[]");
      const stringValues = Array.isArray(value) ? value.filter((item) => typeof item === "string").map(String) : [];
      return new Set(stringValues);
    } catch {
      return new Set([""].filter(Boolean));
    }
  }

  function writeSaved(saved = new Set([""])) {
    localStorage.setItem(storageKey, JSON.stringify([...saved].sort()));
  }

  function refreshButtons() {
    const saved = readSaved();
    for (const element of document.querySelectorAll("[data-save-place]")) {
      if (!(element instanceof HTMLButtonElement)) continue;
      const placeId = element.dataset.placeId ?? "";
      const placeName = element.dataset.placeName ?? "place";
      const isSaved = saved.has(placeId);
      element.setAttribute("aria-pressed", String(isSaved));
      const label = isSaved ? `Saved: ${placeName}` : `Save ${placeName}`;
      element.setAttribute("aria-label", label);
      element.setAttribute("title", label);
      const labelElement = element.querySelector("[data-save-label]");
      if (labelElement instanceof HTMLElement) labelElement.textContent = label;
      const icon = element.querySelector("[data-save-icon]");
      if (icon instanceof SVGPathElement) {
        icon.setAttribute("fill", isSaved ? "currentColor" : "none");
      }
    }
  }

  for (const element of document.querySelectorAll("[data-save-place]")) {
    if (!(element instanceof HTMLButtonElement) || element.dataset.saveReady) continue;
    element.dataset.saveReady = "true";
    element.addEventListener("click", () => {
      try {
        const saved = readSaved();
        const placeId = element.dataset.placeId ?? "";
        if (saved.has(placeId)) saved.delete(placeId);
        else saved.add(placeId);
        writeSaved(saved);
        refreshButtons();
        window.dispatchEvent(new CustomEvent("travel:savedplaceschange"));
      } catch {
        const message = "Saving is unavailable in this browser";
        element.setAttribute("aria-label", message);
        const label = element.querySelector("[data-save-label]");
        if (label instanceof HTMLElement) label.textContent = message;
      }
    });
  }
  refreshButtons();
</script>
