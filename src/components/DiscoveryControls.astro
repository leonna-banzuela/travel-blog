<form class="control-bar" role="search" aria-label="Filter travel stories">
  <label class="search-field">
    <span class="sr-only">Search stories</span>
    <span aria-hidden="true">⌕</span>
    <input type="search" name="query" placeholder="Search a place or story" />
  </label>

  <div class="control-group" aria-label="Quick filters">
    <button class="chip is-active" type="button" aria-pressed="true">All stories</button>
    <button class="chip" type="button" aria-pressed="false">Beach</button>
    <button class="chip" type="button" aria-pressed="false">Auckland</button>
  </div>

  <button class="button button--ink" type="submit">Search</button>
</form>
