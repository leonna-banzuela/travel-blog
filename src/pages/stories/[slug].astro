---
import FutureAdSlot from "../../components/FutureAdSlot.astro";
import MediaGallery from "../../components/MediaGallery.astro";
import ShareButton from "../../components/ShareButton.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import {
  formatVisitDate,
  splitStoryParagraphs,
  storyViews,
} from "../../content/public-content";
import { siteCatalog } from "../../content/site-data";
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return storyViews(siteCatalog).map((view) => ({
    params: { slug: view.story.slug },
    props: { view },
  }));
}

const { view } = Astro.props;
const paragraphs = splitStoryParagraphs(view.story.bodyMarkdown);
const observedTips = view.story.tips.filter((tip) => tip.perspective === "observed");
const personalTips = view.story.tips.filter((tip) => tip.perspective === "subjective");
const rating = `${view.story.authorRating} out of 5`;
const cover = view.media.find((item) => item.id === view.story.coverMediaId);
---

<BaseLayout
  title={`${view.story.title} · Leonna’s journal`}
  description={view.story.summary}
  image={cover?.kind === "image" ? cover.src : cover?.poster}
  imageAlt={cover?.altText}
>
  <SiteHeader active="stories" />
  <main id="main-content" class="reading-page">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/stories">Stories</a><span aria-hidden="true">/</span>
      <a href={`/areas/${view.area.slug}`}>{view.area.name}</a><span aria-hidden="true">/</span>
      <a href={`/places/${view.place.slug}`}>{view.place.name}</a>
    </nav>

    <article>
      <header class="story-hero">
        <div>
          <p class="eyebrow">{view.place.name} · {view.area.name}</p>
          <h1>{view.story.title}</h1>
          <p class="story-deck">{view.story.summary}</p>
        </div>
        <dl class="story-facts">
          <div><dt>Visited on</dt><dd>{formatVisitDate(view.story.visitDate)}</dd></div>
          <div><dt>Story by</dt><dd><a href={`/creators/${view.author.slug}`}>{view.author.name}</a></dd></div>
          <div><dt>Personal rating</dt><dd aria-label={rating}>{view.story.authorRating} / 5</dd></div>
        </dl>
      </header>

      <div class="story-actions">
        <ShareButton title={view.story.title} />
        <a class="button button--paper" href={`/places/${view.place.slug}`}>More at this place</a>
      </div>

      <MediaGallery media={view.media} />

      <section class="story-section story-copy" aria-labelledby="story-title">
        <p class="eyebrow">The story</p>
        <h2 id="story-title" class="sr-only">{view.story.title}</h2>
        {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </section>

      {
        (observedTips.length > 0 || personalTips.length > 0) && (
          <section class="story-section" aria-labelledby="tips-title">
            <div class="section-heading reading-heading">
              <div>
                <p class="eyebrow">Worth remembering</p>
                <h2 id="tips-title">Tips from this visit</h2>
              </div>
            </div>
            <div class="tip-grid">
              {personalTips.map((tip) => (
                <article class="sticky-note reading-note">
                  <p class="handwritten">Leonna’s note</p>
                  <p>{tip.text}</p>
                </article>
              ))}
              {observedTips.map((tip) => (
                <article class="fact-note">
                  <p class="handwritten">Observed on this date</p>
                  <p>{tip.text}</p>
                </article>
              ))}
            </div>
          </section>
        )
      }

      {
        view.story.externalLinks.length > 0 && (
          <section class="story-section" aria-labelledby="links-title">
            <div class="section-heading reading-heading">
              <div>
                <p class="eyebrow">Plan carefully</p>
                <h2 id="links-title">Useful links</h2>
              </div>
            </div>
            <ul class="external-links">
              {view.story.externalLinks.map((link) => (
                <li><a href={link.url} rel="noreferrer">{link.label} ↗</a></li>
              ))}
            </ul>
          </section>
        )
      }

      <FutureAdSlot />

      <footer class="story-footer">
        <p>Filed under {view.story.tags.join(" · ")}</p>
        <a class="text-link" href={`/areas/${view.area.slug}`}>More from {view.area.name} <span>→</span></a>
      </footer>
    </article>
  </main>
</BaseLayout>
