---
import DiscoveryControls from "../components/DiscoveryControls.astro";
import SiteHeader from "../components/SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Travel stories by Leonna Banzuela"
  description="A map-first editorial travel journal beginning with Auckland."
>
  <SiteHeader active="stories" />

  <main id="main-content" class="app-shell">
    <aside class="side-rail" aria-label="Journal sections">
      <p class="rail-label">Explore</p>
      <a class="is-active" href="#map">Latest map</a>
      <a href="#stories">Recent stories</a>
      <a href="/design-system">UI preview</a>
      <p class="rail-note">A quiet record of where I went and when.</p>
    </aside>

    <div class="page-canvas">
      <section class="page-intro" aria-labelledby="page-title">
        <div>
          <p class="eyebrow">Auckland, New Zealand</p>
          <h1 id="page-title">Every place holds a dated story.</h1>
        </div>
        <p>
          Browse Leonna’s travel notes by map, place, and visit date. The first story is being
          prepared from Sandy Beach.
        </p>
      </section>

      <DiscoveryControls />

      <section id="map" class="map-panel" aria-labelledby="map-title">
        <div class="map-copy">
          <p class="eyebrow">Map journal</p>
          <h2 id="map-title">Auckland stories</h2>
          <p>Map markers and verified locations arrive with the first published story.</p>
        </div>
        <div class="map-marker map-marker--one" aria-hidden="true"><span>1</span></div>
        <div class="map-marker map-marker--two" aria-hidden="true"><span>+</span></div>
        <p class="map-caption">Read-only public preview · no account required</p>
      </section>

      <section id="stories" class="section-block" aria-labelledby="stories-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">From the notebook</p>
            <h2 id="stories-title">Stories in progress</h2>
          </div>
          <a class="text-link" href="/design-system">View component preview <span>→</span></a>
        </div>

        <div class="card-grid">
          <article class="story-card story-card--feature">
            <div class="card-image-placeholder" aria-hidden="true"><span>Photo coming soon</span></div>
            <div class="card-body">
              <p class="card-kicker">Auckland · 1 November 2026</p>
              <h3>Sandy Beach</h3>
              <p>A first beach note by Leonna Banzuela is being prepared from the original trip media.</p>
              <span class="status-pill">Draft</span>
            </div>
          </article>

          <article class="sticky-note" aria-label="Journal note">
            <p class="handwritten">A note for later</p>
            <h3>Bring the swimsuit next time.</h3>
            <p>Small practical memories belong beside the polished photographs.</p>
          </article>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
