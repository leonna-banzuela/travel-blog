---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Travel stories by Leonna Banzuela"
  description="A map-first editorial travel journal beginning with Auckland."
>
  <header class="site-header">
    <a class="brand" href="/" aria-label="Leonna's travel journal home">
      <span aria-hidden="true">LB</span>
      <strong>Travel journal</strong>
    </a>
    <p class="build-label">Foundation preview</p>
  </header>

  <main id="main-content" class="foundation-shell">
    <section class="intro" aria-labelledby="page-title">
      <p class="eyebrow">Auckland, New Zealand</p>
      <h1 id="page-title">Places become stories.</h1>
      <p>
        This lightweight foundation will grow into an editorial map of the places Leonna has
        visited, beginning with Sandy Beach.
      </p>
    </section>

    <section class="map-placeholder" aria-labelledby="map-title">
      <div>
        <p class="eyebrow">Map and list discovery</p>
        <h2 id="map-title">Auckland stories are coming next</h2>
      </div>
      <p>
        The public site is read-only. Story authoring will stay in a separate owner-only tool on
        this computer.
      </p>
    </section>
  </main>
</BaseLayout>
