---
import DiscoveryControls from "../components/DiscoveryControls.astro";
import MapDiscovery from "../components/MapDiscovery.astro";
import SiteHeader from "../components/SiteHeader.astro";
import StoryCard from "../components/StoryCard.astro";
import { storyViews } from "../content/public-content";
import { siteCatalog } from "../content/site-data";
import BaseLayout from "../layouts/BaseLayout.astro";

const firstStory = storyViews(siteCatalog)[0];
if (!firstStory) throw new Error("The public journal needs one published story.");
---

<BaseLayout
  title="Travel stories by Leonna Banzuela"
  description="A map-first editorial travel journal beginning with Auckland."
>
  <SiteHeader active="stories" />

  <main id="main-content" class="app-shell">
    <div class="page-canvas">
      <h1 class="sr-only">Leonna’s travel map and stories</h1>

      <DiscoveryControls />

      <MapDiscovery view={firstStory} />

      <section id="stories" class="section-block" aria-labelledby="stories-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">From the notebook</p>
          <h2 id="stories-title">Latest story</h2>
          </div>
          <a class="text-link" href="/privacy">How visitor data is handled <span>→</span></a>
        </div>

        <div class="card-grid" data-discovery-list>
          <StoryCard view={firstStory} />

          <article class="sticky-note" aria-label="Journal note">
            <p class="handwritten">A note for later</p>
            <h3>Bring the swimsuit next time.</h3>
            <p>Small practical memories belong beside the polished photographs.</p>
          </article>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
