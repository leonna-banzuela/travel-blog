---
import '../styles/global.css';

const { title, description, image, imageAlt, canonicalPath = Astro.url.pathname } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalPath} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {image && <meta property="og:image" content={image} />}
    {image && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    {image && <meta name="twitter:image" content={image} />}
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot />
    <script>
      const discoveryKeys = new Set([
        "q",
        "category",
        "setting",
        "experience",
        "climate",
        "practical",
        "facilities",
        "sort",
        "saved",
      ]);

      function preserveDiscoveryContext(query = window.location.search.slice(1)) {
        const source = new URLSearchParams(query);
        const context = new URLSearchParams();
        for (const [key, value] of source) {
          if (discoveryKeys.has(key)) context.set(key, value);
        }
        for (const element of document.querySelectorAll("[data-preserve-discovery]")) {
          if (!(element instanceof HTMLAnchorElement)) continue;
          const base = element.dataset.baseHref ?? element.getAttribute("href") ?? "/";
          const url = new URL(base, window.location.origin);
          url.search = context.toString();
          element.href = `${url.pathname}${url.search}${url.hash}`;
        }
      }

      window.addEventListener("travel:discoverychange", (event) => {
        if (!(event instanceof CustomEvent)) return;
        preserveDiscoveryContext(typeof event.detail?.query === "string" ? event.detail.query : "");
      });
      preserveDiscoveryContext();
    </script>
  </body>
</html>
